<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RAVEN 自动抓取任务模板（macOS launchd LaunchAgent）
  由 automation/install.sh 自动替换项目路径、HOME 与启动器路径后，
  安装到 ~/Library/LaunchAgents/com.raven.arxiv.daily.plist

  为什么通过启动器（RAVENAutomation.app）而不是直接执行脚本？
  macOS 隐私保护（TCC）不允许 launchd 后台任务直接访问「桌面」上的项目目录。
  启动器是一个 Applet，首次运行时会请求一次「访问桌面文件夹」的权限，
  用户点「允许」后即可每天静默自动抓取。

  触发规则：每周一至周五（Weekday 1..5）本地时间 10:30（Asia/Shanghai）
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.raven.arxiv.daily</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/open</string>
		<string>-g</string>
		<string>-n</string>
		<string>-a</string>
		<string>__APP_PATH__</string>
	</array>

	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>2</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>3</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>5</integer>
			<key>Hour</key>
			<integer>10</integer>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>__HOME__</string>
		<key>PATH</key>
		<string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>Asia/Shanghai</string>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
		<key>LC_ALL</key>
		<string>en_US.UTF-8</string>
		<key>PYTHONIOENCODING</key>
		<string>utf-8</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
	</dict>

	<key>StandardOutPath</key>
	<string>__PROJECT_DIR__/logs/launchd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__PROJECT_DIR__/logs/launchd.stderr.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
