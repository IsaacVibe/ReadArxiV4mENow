# Hidden files/directories stay local. Only this root policy is versioned.
.*
!/.gitignore

# Dependencies, builds, logs, and editor backups
node_modules/
dist/
dist-ssr/
logs/
*.log
*.local
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln
__pycache__/
*.py[cod]
*.app/

# Scraped data and saved conversations (keep the explicit public example)
/public/archive/
/public/RAVEN_*.json
/public/latest.json
/public/papers.json
/RAVEN_*.json
/astroph_*.md
/latest_arxiv_astro_ph.md
/arxiv_results.xml

# Local research arrays and generated shortcuts
*.npy
*.shortcut
